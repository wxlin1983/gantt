# Copy to .env before `docker compose up`.
#
# SESSION_SECRET has no default on purpose: it signs session cookies and
# derives the credential encryption key, so a shared default would mean every
# installation could decrypt every other one's secrets.
SESSION_SECRET=

POSTGRES_PASSWORD=gantt
WEB_PORT=8080
DEFAULT_TIMEZONE=Asia/Taipei

# Hosts the built-in http_request handler may call. Empty refuses everything.
# HTTP_HANDLER_ALLOWED_HOSTS=["ci.internal","jira.internal"]
HTTP_HANDLER_ALLOWED_HOSTS=[]

# shell_command is remote code execution by another name; leave it off unless
# you mean it, and then list the permitted commands.
SHELL_HANDLER_ENABLED=false
